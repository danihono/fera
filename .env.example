# Copie para .env.local e preencha com a config web do seu projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → app Web). Esses valores não são secretos.
# Sem eles o app roda em modo demonstração (prova de exemplo, tudo no aparelho).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 1 = as Cloud Functions do modo qualidade estão no ar (Fera+ usa Claude + Gemini + GPT Image)
EXPO_PUBLIC_IA_QUALIDADE=

# Modelo do modo grátis (Firebase AI Logic)
# EXPO_PUBLIC_GEMINI_MODELO=gemini-3.5-flash

# Testar com os emuladores locais (npm run emuladores): o IP do computador na rede (celular) ou 127.0.0.1 (web)
# EXPO_PUBLIC_FIREBASE_EMULADOR=192.168.0.10

# Forçar um modo: demo | gratis | qualidade
# EXPO_PUBLIC_IA_MODO=
