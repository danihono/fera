# Modelos de cada provedor (dá pra trocar sem mexer no código). As chaves ficam no Secret Manager:
#   firebase functions:secrets:set ANTHROPIC_API_KEY   (e GEMINI_API_KEY, OPENAI_API_KEY)
FERA_MODELO_CLAUDE=claude-opus-5
# Opcional: modelo só pros materiais (as questões continuam no de cima). Ex.: claude-sonnet-5 (~60% mais barato)
# FERA_MODELO_CLAUDE_MATERIAIS=claude-sonnet-5
FERA_MODELO_GEMINI=gemini-3.5-flash
FERA_MODELO_IMAGEM=gpt-image-2
# low | medium | high
FERA_QUALIDADE_IMAGEM=medium
# Provas geradas por pessoa por dia no modo qualidade
FERA_LIMITE_DIA=10
# Teto de gerações por dia no projeto inteiro (protege a sua conta das IAs)
FERA_LIMITE_GLOBAL_DIA=200
# 1 = libera a compra de mentira do Fera+ (prévia com amigos). 0 = só a loja ativa o Fera+.
FERA_COMPRA_TESTE=0
# 1 = recusa chamadas sem App Check (ligue só depois de configurar o App Check no app)
FERA_EXIGIR_APPCHECK=0
# Dias sem abrir o app até a faxina apagar uma conta anônima
FERA_DIAS_ANONIMO=90
