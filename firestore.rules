rules_version = '2';

// Regras do Fera. Cada aluno (login anônimo) só lê e escreve o que é dele;
// turmas são abertas pra quem está logado (o código é o convite) e cada um só mexe na própria linha do ranking.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function eu(uid) {
      return logado() && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read, delete: if eu(uid);
      allow create, update: if eu(uid) && request.resource.data.keys().hasOnly(['estado', 'atualizadoEm']);

      // O que a IA gerou pra cada prova (no modo grátis o próprio app grava).
      match /conteudos/{provaId} {
        allow read, write: if eu(uid);
      }

      // Progresso da geração no servidor: só as Cloud Functions (Admin SDK) escrevem.
      match /geracoes/{provaId} {
        allow read: if eu(uid);
        allow write: if false;
      }
    }

    // Fera+: só o servidor escreve (compra de teste ou webhook da loja). O app só lê a própria.
    match /assinaturas/{uid} {
      allow read: if eu(uid);
      allow write: if false;
    }

    // Uso do projeto (teto diário de gerações): só o servidor.
    match /sistema/{doc} {
      allow read, write: if false;
    }

    match /turmas/{codigo} {
      allow read: if logado();
      allow create: if logado()
        && codigo.matches('^FERA-[A-Z0-9]{3}$')
        && request.resource.data.keys().hasOnly(['nome', 'criadaPor', 'criadaEm'])
        && request.resource.data.criadaPor == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 40;
      allow update, delete: if false;

      // Prova compartilhada: quem é da turma publica a que gerou; a sala toda lê; só o autor muda ou apaga.
      match /provas/{provaId} {
        allow read: if logado();
        allow create: if logado()
          && provaId.matches('^[a-z0-9]{6,40}$')
          && exists(/databases/$(database)/documents/turmas/$(codigo)/membros/$(request.auth.uid))
          && request.resource.data.autor == request.auth.uid
          && request.resource.data.materia is string
          && request.resource.data.materia.size() <= 40
          && request.resource.data.conteudo is map;
        allow update: if logado()
          && resource.data.autor == request.auth.uid
          && request.resource.data.autor == request.auth.uid;
        allow delete: if logado() && resource.data.autor == request.auth.uid;
      }

      match /membros/{uid} {
        allow read: if logado();
        allow delete: if eu(uid);
        allow create, update: if eu(uid)
          && exists(/databases/$(database)/documents/turmas/$(codigo))
          && request.resource.data.keys().hasOnly(['nome', 'inicial', 'xp', 'foto', 'atualizadoEm'])
          && request.resource.data.nome is string
          && request.resource.data.nome.size() <= 30
          && request.resource.data.xp is int
          && request.resource.data.xp >= 0
          // Foto miniatura (72 px, data:image/jpeg;base64,…) pro pódio e a lista.
          && (!('foto' in request.resource.data)
              || (request.resource.data.foto is string
                  && request.resource.data.foto.size() <= 12288
                  && request.resource.data.foto.matches('^data:image/(jpeg|png|webp);base64,.*')));
      }
    }
  }
}
